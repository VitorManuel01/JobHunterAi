# ==============================================================
# Configurações de E-mail para Disparo Automático de Candidaturas
# ==============================================================

# Seu e-mail de envio (padrão: Hotmail)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=seu_email@exemplo.com

# Senha de Aplicativo (App Password)
# Como gerar para Hotmail/Outlook:
# 1. Acesse https://account.microsoft.com/security
# 2. Em Opções de Segurança Avançadas -> Senhas de aplicativo -> Criar uma nova senha.
# 3. Cole a senha gerada abaixo e renomeie este arquivo para .env
EMAIL_PASSWORD=
